<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SophosVpnMiniTool</AssemblyName>
    <RootNamespace>SophosVpnMiniTool</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>Marc Woge</Authors>
    <Company>Marc Woge</Company>
    <Product>SophosVpnMiniTool</Product>
    <Description>Windows desktop tool for controlling Sophos Connect VPN via sccli.exe.</Description>
    <Copyright>Copyright (c) 2026 Marc Woge</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
